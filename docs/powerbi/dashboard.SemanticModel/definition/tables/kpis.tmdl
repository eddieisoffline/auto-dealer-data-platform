	measure 'Num Ventas Día' = SUM ( kpi_diario[num_ventas] )
		formatString: 0
		lineageTag: beba1a2c-30ab-48d0-84f9-a7600f2d1cd3

	measure 'Margen Bruto Día %' = DIVIDE ( [Utilidad Bruta Día], [Ventas Día] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
