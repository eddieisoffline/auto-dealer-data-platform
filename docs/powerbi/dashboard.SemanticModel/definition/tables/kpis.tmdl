		lineageTag: 470d154e-2112-48ee-85a5-36be84720d96

	measure 'Ticket Promedio' = DIVIDE ( [Ventas], [Num Ventas] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 803b1405-5840-4836-b5be-f91551209bd4

