# Copia este archivo a terraform.tfvars (ignorado por git) y ajústalo.
project_id = "tu-proyecto-gcp"
region     = "us-central1"

# Paso 1: infraestructura base. Paso 2: sube la imagen y cambia a true.
deploy_job = false
# image    = "us-central1-docker.pkg.dev/tu-proyecto-gcp/pipeline/pipeline:0.1.0"

# Opcional: despliegue automático desde GitHub Actions (owner/repo)
# github_repository = "eddieisoffline/auto-dealer-data-platform"

# Opcional: alerta de presupuesto (ID de tu cuenta de facturación)
# billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
# budget_amount      = 5

# Opcional: imágenes que conserva Artifact Registry (por defecto 5)
# images_to_keep = 5

# Solo para borrar todo: true permite que terraform destroy elimine el bucket y
# los datasets de BigQuery con sus datos. Aplica antes de destruir (ver docs/despliegue.md).
# force_destroy = true
